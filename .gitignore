# ============================================================================
# Git 忽略规则 - Python 项目通用模板
# ============================================================================

# ---- Python 字节码与缓存 ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ---- 虚拟环境 ----
venv/
.venv/
env/
.env/

# ---- 环境变量文件（含敏感信息） ----
.env
.env.*
!.env.example

# ---- IDE 与编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---- Jupyter Notebook ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- 日志 ----
logs/*.log
logs/*.log.*

# ---- 数据与缓存 ----
data/cache/
*.parquet
*.feather

# ---- 报告输出（可选：如需追踪报告则注释掉此行） ----
reports/*.html
reports/*.png
reports/*.pdf
reports/data_quality_*.json
reports/data_download_manifest.json
reports/real_data_collection_manifest.json
reports/data_catalog.json
reports/data_health.json
reports/single_factor/[A-Z]*_*.json
reports/ml_factor/[A-Z]*_*.json
reports/strategy_snapshots/

# ---- 分发/打包 ----
dist/
build/
*.egg-info/
*.egg

# ---- 测试 ----
.pytest_cache/
.test-tmp/
.tmp_pytest/
.tmp_pytest_*/
.coverage
htmlcov/
.tox/

# ---- 其他 ----
*.tmp
*.bak
